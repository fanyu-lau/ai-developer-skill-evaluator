{
  "hooks": {
    "SessionStart": [{
      "hooks": [{ "type": "command", "command": "pawskill claude-hook", "timeout": 3 }]
    }],
    "PostToolUse": [{
      "matcher": "Edit|Write|Bash",
      "hooks": [{ "type": "command", "command": "pawskill claude-hook", "timeout": 3 }]
    }],
    "PostToolUseFailure": [{
      "matcher": "Edit|Write|Bash",
      "hooks": [{ "type": "command", "command": "pawskill claude-hook", "timeout": 3 }]
    }],
    "Stop": [{
      "hooks": [{ "type": "command", "command": "pawskill claude-hook", "timeout": 3 }]
    }]
  }
}
